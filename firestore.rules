rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function studentDirectoryOperator() {
      return signedIn()
        && request.auth.token.email == 'jh62231310@s.musashi.ed.jp';
    }

    // Student records contain personal information. Only the directory
    // operator can read or replace the shared directory document.
    match /student_directory/current {
      allow read: if studentDirectoryOperator();
      allow create, update: if studentDirectoryOperator()
        && request.resource.data.keys().hasOnly(['rows', 'fields', 'updatedAt', 'updatedBy'])
        && request.resource.data.rows is list
        && request.resource.data.fields is list
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    // App state is shared by the event, timetable, and ball-sports pages.
    // The current clients use Google sign-in but do not all share one
    // application-level allowlist, so access requires a verified account.
    match /app_data/{documentId} {
      allow read, write: if signedIn();

      // Ball-sports backup history is stored below app_data in snapshots.
      match /snapshots/{snapshotId} {
        allow read, write: if signedIn();
      }
    }

    // Older ball-sports deployments may still use this collection.
    match /sportsfes/{documentId} {
      allow read, write: if signedIn();
    }

    // Input history is visible to signed-in staff and written by the
    // timetable and team-event pages.
    match /input_history/{entryId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // Equipment checkout data is shared by the lending pages.
    match /equipment/{equipmentId} {
      allow read, write: if signedIn();
    }

    match /history/{entryId} {
      allow read, create, delete: if signedIn();
      allow update: if false;
    }

    match /settings/{documentId} {
      allow read, write: if signedIn();
    }

    // All collections not listed above are denied by default.
  }
}
